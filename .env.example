# ---- Copy to .env (project root) and fill in. Never commit .env. ----

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (schema-based multi-tenancy needs PostgreSQL)
DB_NAME=gst_billing_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://user:pass@host:5432/dbname      # Railway style; overrides the DB_* values

# Tenants live at {slug}.{TENANT_BASE_DOMAIN}
#   dev  : localhost                  -> sharma.localhost:5173
#   prod : app.techcognixium.com      -> sharma.app.techcognixium.com   (needs wildcard DNS + TLS)
TENANT_BASE_DOMAIN=localhost

# Razorpay - while these start with "dummy" (and DEBUG=True) checkout runs in a safe DEMO mode
RAZORPAY_KEY_ID=dummy_for_now
RAZORPAY_KEY_SECRET=dummy_for_now
# After adding real keys run:  python manage.py create_razorpay_plans   and paste the two IDs here
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
# Webhook: POST https://<public-domain>/api/public/razorpay/webhook/  (events: subscription.activated/charged/cancelled/halted/completed)
RAZORPAY_WEBHOOK_SECRET=

# Email (password-reset OTP). Empty = codes are printed in the server console.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Tech Cognixium <noreply@techcognixium.com>

# Legacy only: logos now live in the database, so this is no longer needed for them.
# MEDIA_ROOT=

# Windows only: folder with Pango/GTK DLLs for WeasyPrint (default C:\msys64\mingw64\bin)
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
